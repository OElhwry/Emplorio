# --- Core ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=3001
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_TTL_DAYS=30

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host/emplorio?sslmode=require

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:password@host:6379

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- Extension auth (shared secret) ---
# Generate with: openssl rand -hex 24
# When set, /generate routes require Authorization: Bearer <key>
EMPLORIO_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Emplorio <noreply@emplorio.app>"

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=emplorio-docs
R2_PUBLIC_URL=

# --- Logs (Axiom) ---
AXIOM_TOKEN=
AXIOM_DATASET=emplorio

# --- Web ---
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# --- Extension ---
VITE_API_ORIGIN=http://localhost:3001
# Must match EMPLORIO_API_KEY above for prod builds
VITE_EMPLORIO_API_KEY=
